<%- include('../partials/head') %>
<main class="auth-shell">
  <div class="card axiom-card auth-panel">
    <div class="card-body p-4 p-lg-5 text-center">
      <p class="eyebrow mb-1">500</p>
      <h1 class="h3 fw-bold">Server error</h1>
      <p class="text-muted">Something went wrong while processing the request.</p>
      <% if (error) { %>
        <pre class="text-start small bg-light p-3 rounded"><%= error.stack || error.message %></pre>
      <% } %>
      <a class="btn btn-accent" href="/dashboard">Go to dashboard</a>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
