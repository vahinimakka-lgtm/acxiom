<%- include('../partials/head') %>
<%- include('../partials/flash') %>
<main class="auth-shell">
  <div class="auth-panel card axiom-card">
    <div class="card-body p-4 p-lg-5">
      <p class="eyebrow mb-1">AxiomCRM</p>
      <h1 class="h3 fw-bold mb-3">Sign in</h1>
      <p class="text-muted mb-4">Use the seeded demo accounts or a registered user.</p>

      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input class="form-control" type="email" name="email" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input class="form-control" type="password" name="password" required>
        </div>
        <button class="btn btn-accent w-100" type="submit">Sign in</button>
      </form>

      <div class="mt-3 d-flex justify-content-between small text-muted">
        <span>Admin: admin@acxiom.local / Admin@123</span>
        <a href="/register">Register</a>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
